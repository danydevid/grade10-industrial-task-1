---
import Layout from '../layouts/Layout.astro';
import Typewriter from '../components/Typewriter.astro';
import ContactCard  from '../components/contactCard.astro';
const baseUrl = import.meta.env.BASE_URL; 

// contact data in JSON format (for easy looping)
let contact = [
  {
    title: "Instagram",
    iconUrl: "/grade10-industrial-task-1/contactIco/instagram.svg",
    contactUrl: "https://instagram.com/@mrtechnix"
  },
  {
    title: "Github",
    iconUrl: "/grade10-industrial-task-1/contactIco/github.png",
    contactUrl: "https://github.com/danydevid"
  }
]

---

<Layout>
  <!-- hero section -->
  <section class="paralax" id="hero">
    <!-- background layer (animated by Rellax) -->
    <div class="bg rellax" data-rellax-speed="-6" data-rellax-percentage="0.5"
         style="background-image: url('/grade10-industrial-task-1/hero-background.jpg')"></div>
    <div class="container rellax" data-rellax-speed="-3" data-rellax-percentage="0.5">
      <h1><Typewriter text={["HI THERE👋", "DANY SAPUTRA", "JUNIOR SOFTWARE DEVELOPER", "X RPL 1", "SMKN PASURUAN"]} speed="50"/></h1>
      <p id="text-hero">Hi. My name is Dany Saputra, I am in grade 10 Software Engineering at UPT State Vocational High School 1 Pasuruan, East Java. I am a student who aspires to become a software architect.</p>
    </div>
  </section>

  <!-- material section -->
  <section class="paralax" id="material">
    <!-- background layer (moved by Rellax) -->
    <div class="bg rellax" data-rellax-speed="-6" data-rellax-percentage="0.5"
         style="background-image: url('/grade10-industrial-task-1/material.png')"></div>
    <div class="container rellax" data-rellax-speed="-2" data-rellax-percentage="0.5">
      <h1>Skills I'm Currently Learning</h1>
      <ul>
        <li>HTML - Web page structure</li>
        <li>CSS - Web appearance & design</li>
        <li>JavaScript - Web interaction (coming soon!)</li>
      </ul>
    </div>
  </section>

  <!-- skills section -->
  <section class="paralax" id="skills">
    <!-- background layer (moved by Rellax) -->
    <div class="bg rellax" data-rellax-speed="-6" data-rellax-percentage="0.5"
         style="background-image: url('/grade10-industrial-task-1/skills-bg.png')"></div>
    <div class="container rellax" data-rellax-speed="-2" data-rellax-percentage="0.5">
      <h1>My Skills</h1>
      <ul>
        <li>Golang - basic</li>
        <li>C - basic</li>
        <li>JavaScript - Intermediate (async await, callback, promises)</li>
        <li>Git - Basic (commit, create branch, pr)</li>
        <li>GitHub - Basic (merge, GitHub CI, hooks)</li>
        <li>Frontend web - beginner</li>
      </ul>
    </div>
  </section>

  <!-- contact section -->
  <section class="paralax" id="contact">
    <!-- background layer (moved by Rellax) -->
    <div class="bg rellax" data-rellax-speed="-6" data-rellax-percentage="0.5"
         style="background-image: url('/grade10-industrial-task-1/contact-bg.jpg')"></div>
    <div class="container rellax" data-rellax-speed="-3" data-rellax-percentage="0.5">
      <h1>Contact</h1>
      <!-- render contactCard and pass contact data in props -->
      <ContactCard dataContact={ contact }/>
    </div>
  </section>
</Layout>

<style>
  /* paralax style */
  .paralax {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;

    /* paralax */
    position: relative;
    overflow: hidden; /* so the shifted background doesn't leak outside the section */
  }

  /* background layer, moved by Rellax */
  .bg {
    position: absolute;
    top: -20%;        /* negative offset so there's room to shift upward */
    left: 0;
    width: 100%;
    height: 140%;     /* taller than the section so no gap appears */
    background-position: right;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 0;
  }

  #contact {
    background-position: center;
    display: grid;
    place-items: center;
  }

  /* content is above the background layer */
  .container {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 5em 0 0.5em 1.5em;
  }

  #text-hero { max-width: 500px; }

  .rellax {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rellax { transform: none !important; }
  }
</style>


<!-- rellax -->
<script>
  // @ts-ignore
  import Rellax from 'rellax';

  // Rellax init
  const rellax = new Rellax('.rellax', {
    speed: -2,
    center: false,
    wrapper: undefined,  
    round: true,
    vertical: true,
    horizontal: false
  });
</script>

<script>
  var sections = document.querySelectorAll('.paralax');
  var current = 0;
  
  // Set current berdasarkan hash kalau user buka #section
  if (location.hash) {
    for (var i = 0; i < sections.length; i++) {
      if ('#' + sections[i].id === location.hash) { current = i; break; }
    }
  }
  
  window.addEventListener('keydown', function (e) {
    
    //@ts-ignore
    var tag = e.target.tagName;
    //@ts-ignore
    if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;
    
    var n = parseInt(e.key, 10);
    if (!isNaN(n) && n >= 1 && n <= sections.length) {
      e.preventDefault();
      current = n - 1;
      sections[current].scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', '#' + sections[current].id);
      return;
    }


    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (current < sections.length - 1) current++;
      sections[current].scrollIntoView();
      history.replaceState(null, '', '#' + sections[current].id);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (current > 0) current--;
      sections[current].scrollIntoView();
      history.replaceState(null, '', '#' + sections[current].id);
    }
  });
</script>