---
// declare the content of the data that will be received from props
interface ContactData {
  title: string;
  iconUrl: string;
  contactUrl: string;
}

// declare the interface for props with dataContact content that will be treated as an array
interface Props {
  dataContact: ContactData[];
}

const { dataContact } = Astro.props
---


<!-- div to wrap a set of contact cards -->
<div class="container-card">
  <!-- iterate dataContact to render it to the browser as cards -->
  {dataContact.map((data) => (
    <div>
      <a href={data.contactUrl}>
        <img src={data.iconUrl} alt={data.title} width="80"/>
        <p>{data.title}</p>
      </a>
    </div>
  ))}
</div>

<style>
  
  .container-card {
    color: whitesmoke;
    display: flex;
    gap: 1em;
    text-align: center;
  }

  a {
    text-decoration: none;
    color: whitesmoke;
  }

</style>