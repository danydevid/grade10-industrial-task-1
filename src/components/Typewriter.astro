---
const { text } = Astro.props;

// normalize the array from props
const formattedText = Array.isArray(text) ? text : [text];
---

<!-- place to put the animated text -->
<span id="typed" data-strings={JSON.stringify(formattedText)}></span>

<script>
  import Typed from 'typed.js';

  // get the span using HTMLSpanElement to tell TypeScript that we are looking for an HTML span
  const element = document.querySelector<HTMLSpanElement>('#typed');
  

  if (element) {
    // parse json with normalization if the variable doesn't exist with an empty array
    const strings = JSON.parse(element.dataset.strings || '[]');

    // init typed.js
    new Typed('#typed', {
      strings: strings,
      typeSpeed: 50,
      backSpeed: 60,
      loop: true
    });
  }
</script>