---
import Navbar from "../components/Navbar.astro";

const name = "Dany Saputra"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <!-- root untuk page -->
  <div class="root">
    <Navbar name={ name }/>
    <slot/>
  </div>
</body>
</html>


<style>
  /* clearing padding & margin bawaan html */
  * {
    padding: 0px;
    margin: 0px;
    box-sizing: border-box;
  }
</style>